<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Genel Arkaplan -->
    <Style Selector="Window">
        <Setter Property="Background" Value="#242424"/>
    </Style>

    <!-- TextBox / ComboBox Stilleri -->
    <Style Selector="TextBox, ComboBox">
        <Setter Property="Background" Value="#2b2b2b"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#444444"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Margin" Value="0,2"/>
    </Style>

    <!-- Buton Temel Stili -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!-- Mavi Buton (Profil, Ekle) -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="#1f538d"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#2b5278"/>
    </Style>

    <!-- Yeşil Buton (Başlat, Koordinat Ekle) -->
    <Style Selector="Button.success">
        <Setter Property="Background" Value="#198754"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.success:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#146c43"/>
    </Style>

    <!-- Kırmızı Buton (Durdur, Sil) -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="#dc3545"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#bb2d3b"/>
    </Style>

    <!-- Koyu Gri Buton (Yukarı/Aşağı Taşı) -->
    <Style Selector="Button.neutral">
        <Setter Property="Background" Value="#333333"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.neutral:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#444444"/>
    </Style>

    <!-- ListBox Stilleri (Koordinatlar ve Komutlar için) -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="#1a1a1a"/>
        <Setter Property="BorderBrush" Value="#333333"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="5"/>
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="5,2"/>
    </Style>

    <!-- Log Ekranı -->
    <Style Selector="TextBox.log">
        <Setter Property="Background" Value="#1a1a1a"/>
        <Setter Property="Foreground" Value="#00ff00"/>
        <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsReadOnly" Value="True"/>
    </Style>

    <Style Selector="TextBlock.header">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
</Styles>