<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WaydroidController.ViewModels"
        x:Class="WaydroidController.Views.MiniWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Mini Mod" Width="200" Height="50"
        CanResize="False"
        WindowDecorations="None"
        Topmost="True"
        WindowStartupLocation="CenterScreen">

        <!-- x:Name eklendi, PointerPressed silindi -->
        <Grid x:Name="DragArea" ColumnDefinitions="Auto,*,Auto" Margin="5,8">
                <TextBlock Text="{Binding MiniCountdownText}" FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                           Foreground="#00ffcc" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                        <Button Content="▶" Width="36" Height="28" Classes="success" FontSize="14"
                                Command="{Binding StartCommand}" IsEnabled="{Binding !IsRunning}"/>
                        <Button Content="■" Width="36" Height="28" Classes="danger" FontSize="14"
                                Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}"/>
                        <Button Content="⚙" Width="28" Height="28" Classes="primary" FontSize="13"
                                Click="OnBackToMainClick"/>
                </StackPanel>
        </Grid>
</Window>