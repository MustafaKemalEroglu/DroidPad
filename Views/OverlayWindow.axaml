<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WaydroidController.ViewModels"
        xmlns:m="using:WaydroidController.Models"
        x:Class="WaydroidController.Views.OverlayWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Waydroid Controller"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Topmost="True"
        WindowState="Maximized">

    <!-- Ana Grid fare olaylarını yakalar -->
    <Grid Background="Transparent"
          PointerPressed="OnMainPointerPressed"
          PointerMoved="OnMainPointerMoved"
          PointerReleased="OnMainPointerReleased">

        <!-- 0. Düzenleme Modu Karartma -->
        <Border Background="#44000000" IsVisible="{Binding State.IsPanelOpen}" IsHitTestVisible="False"/>

        <!-- 1. Tap Tuşları -->
        <ItemsControl ItemsSource="{Binding KeyBindings}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas Background="Transparent"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Styles>
                <Style Selector="ContentPresenter" x:DataType="m:KeyBinding">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="42" Height="42" CornerRadius="21"
                            BorderThickness="1.5"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Classes.pressed="{Binding IsPressed}"
                            Tag="{Binding}">
                        <Border.Styles>
                            <Style Selector="Border">
                                <Setter Property="Background" Value="#AA1E1E1E"/>
                                <Setter Property="BorderBrush" Value="#00FFCC"/>
                            </Style>
                            <Style Selector="Border.pressed">
                                <Setter Property="Background" Value="#B300FF66"/>
                                <Setter Property="BorderBrush" Value="#FFFFFF"/>
                            </Style>
                        </Border.Styles>
                        <TextBlock Text="{Binding KeyName}" Foreground="#FFFFFF"
                                   FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 2. Joystick Grupları -->
        <ItemsControl ItemsSource="{Binding JoystickGroups}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas Background="Transparent"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Styles>
                <Style Selector="ContentPresenter" x:DataType="m:JoystickGroup">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Width="140" Height="140" Margin="-70,-70,0,0" Background="Transparent" Tag="{Binding}">
                        <Ellipse Width="140" Height="140" Stroke="#00FFCC" StrokeThickness="2" Fill="#221E1E1E" IsHitTestVisible="False"/>
                        <!-- Yön tuşları aynı, sadece örnek olarak bırakıldı -->
                        <Border Width="36" Height="36" CornerRadius="18" Background="#AA1E1E1E" BorderBrush="#00FFCC" BorderThickness="1.5"
                                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" IsHitTestVisible="False">
                            <TextBlock Text="{Binding UpKey}" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Diğer yönler... -->
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 3. Sağ Tık Menüsü -->
        <Border IsVisible="{Binding State.IsContextMenuOpen}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Width="160" Background="#DD242424" BorderBrush="#444" BorderThickness="1" CornerRadius="6" Padding="6"
                ZIndex="1000">
            <Border.RenderTransform>
                <TranslateTransform X="{Binding State.ContextMenuX}" Y="{Binding State.ContextMenuY}"/>
            </Border.RenderTransform>
            <StackPanel Spacing="4">
                <TextBlock Text="Tuş Ekle" Foreground="#888" FontSize="11" FontWeight="Bold" Margin="4,2"/>
                <Button Content="➕ Tap (Dokunma) Ekle" Command="{Binding AddTapFromContextMenuCommand}"/>
                <Button Content="🎮 Joystick (WASD) Ekle" Command="{Binding AddJoystickFromContextMenuCommand}"/>
            </StackPanel>
        </Border>

        <!-- 4. Sidebar (Aynen korundu) -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Background="#DD1E1E1E" BorderBrush="#333333" BorderThickness="1,0,0,0"
                Padding="3,15,3,10" Width="40">
            <StackPanel Spacing="15" HorizontalAlignment="Center">
                <Button Content="⌨" ToolTip.Tip="Tuş Atama Modunu Aç/Kapat (F12)"
                        Classes="primary" Width="38" Height="38" FontSize="16"
                        Command="{Binding TogglePanelCommand}"/>
                <Separator Background="#444" Height="1" Margin="2,0"/>
                <Button Content="🎯" ToolTip.Tip="Koordinat Seç"
                        Classes="neutral" Width="38" Height="38" FontSize="14"
                        Command="{Binding StartPickingCoordinateCommand}"/>
                <Button Content="⚙" ToolTip.Tip="Ayarlar"
                        Classes="neutral" Width="38" Height="38" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- 5. Bilgi Bandı -->
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Spacing="5" Margin="0,15,0,0" ZIndex="999">
            <Border Background="#CC0066FF" IsVisible="{Binding State.IsPanelOpen}" Padding="15,6" CornerRadius="6">
                <TextBlock Text="💡 Düzenleme Modu (F12): Sağ tık menü, sürükle-bırak aktif."
                           Foreground="White" FontWeight="SemiBold" FontSize="12"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>