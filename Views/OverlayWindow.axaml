<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WaydroidController.ViewModels"
        xmlns:m="using:WaydroidController.Models"
        x:Class="WaydroidController.Views.OverlayWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Waydroid Controller"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        Topmost="True"
        WindowState="Maximized">

    <Grid>
        <!-- 1. Ekran Üzerindeki Tuş Rozetleri (Canvas) -->
        <ItemsControl ItemsSource="{Binding KeyBindings}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <!-- Avalonia'da container stillerini Styles içerisindeki ContentPresenter ile tanımlıyoruz -->
            <ItemsControl.Styles>
                <Style Selector="ContentPresenter" x:DataType="m:KeyBinding">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                </Style>
            </ItemsControl.Styles>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="40" Height="40" CornerRadius="20"
                            BorderThickness="1.5"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Classes.pressed="{Binding IsPressed}">
                        <Border.Styles>
                            <!-- Normal Durum: %40 Şeffaf Siyah Arka Plan & Yarı Şeffaf Neon Çerçeve -->
                            <Style Selector="Border">
                                <Setter Property="Background" Value="#66000000"/>
                                <Setter Property="BorderBrush" Value="#8800FFCC"/>
                            </Style>
                            <!-- Tuşa Basıldığı An: %70 Şeffaf Parlak Yeşil -->
                            <Style Selector="Border.pressed">
                                <Setter Property="Background" Value="#B300FF66"/>
                                <Setter Property="BorderBrush" Value="#FFFFFF"/>
                            </Style>
                        </Border.Styles>

                        <TextBlock Text="{Binding KeyName}" Foreground="#E0FFFFFF"
                                   FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 2. Sağdan Açılır-Kapanır Kontrol Paneli -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Spacing="5">
            <!-- Paneli Aç/Kapat Butonu -->
            <Button Content="⚙ Kontrol Paneli" Classes="primary" Width="120" Height="32" Click="OnTogglePanelClick"/>

            <!-- Yan Panel (Düzenli Sekmeli Yapı) -->
            <Border x:Name="SettingsPanel" Width="330" Height="680" Background="#DD242424" BorderBrush="#444444" BorderThickness="1" CornerRadius="6" IsVisible="False" Padding="10">
                <Grid RowDefinitions="Auto, *">

                    <!-- Başlık -->
                    <TextBlock Grid.Row="0" Text="Waydroid Kontrol Merkezi" Classes="header" Margin="0,0,0,8"/>

                    <!-- Sekmeli İçerik Alanı -->
                    <TabControl Grid.Row="1" Margin="0,0,0,0">

                        <!-- SEKME 1: TUŞ EŞLEME -->
                        <TabItem Header="Tuşlar">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="8" Margin="0,5,0,0">
                                    <TextBlock Text="Tuş Atama (Key Mapper)" Classes="header"/>
                                    <Grid ColumnDefinitions="50, *" RowDefinitions="Auto, Auto, Auto" Margin="0,0,0,5">
                                        <TextBlock Text="Tuş:" VerticalAlignment="Center" Foreground="White"/>
                                        <TextBox Grid.Column="1" Text="{Binding MapButtonKey}" Height="28"/>

                                        <TextBlock Grid.Row="1" Text="Tip:" VerticalAlignment="Center" Foreground="White"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding KeyBindingTypes}" SelectedItem="{Binding MapButtonType}" Height="28"/>

                                        <TextBlock Grid.Row="2" Text="Hedef:" VerticalAlignment="Center" Foreground="White"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MapTargetCoord}" Height="28"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="5">
                                        <Button Content="Ekle/Güncelle" Classes="success" Command="{Binding AddKeyBindingCommand}" Height="30"/>
                                        <Button Grid.Column="1" Content="Sil" Classes="danger" Command="{Binding RemoveKeyBindingCommand}" Height="30"/>
                                    </Grid>
                                    <ListBox Height="220" ItemsSource="{Binding KeyBindings}" SelectedItem="{Binding SelectedKeyBinding}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding KeyName, StringFormat='Tuş [{0}]'}" FontFamily="Consolas" Foreground="#ff77ff"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- SEKME 2: KOORDİNATLAR -->
                        <TabItem Header="Koordinat">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="8" Margin="0,5,0,0">
                                    <TextBlock Text="Koordinat Tanımla" Classes="header"/>

                                    <!-- Ekrandan Tıklayarak Seç Butonu -->
                                    <Button Content="🎯 Ekrandan Seç (Tıkla)" Classes="warning" Command="{Binding StartPickingCoordinateCommand}" Height="32" Margin="0,0,0,3"/>

                                    <Grid ColumnDefinitions="50, *" RowDefinitions="Auto, Auto, Auto" Margin="0,0,0,5">
                                        <TextBlock Text="İsim:" VerticalAlignment="Center" Foreground="White"/>
                                        <TextBox Grid.Column="1" Text="{Binding CoordName}" Height="28"/>

                                        <TextBlock Grid.Row="1" Text="X:" VerticalAlignment="Center" Foreground="White"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CoordX}" Height="28"/>

                                        <TextBlock Grid.Row="2" Text="Y:" VerticalAlignment="Center" Foreground="White"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CoordY}" Height="28"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="5">
                                        <Button Content="Ekle" Classes="success" Command="{Binding AddCoordinateCommand}" Height="30"/>
                                        <Button Grid.Column="1" Content="Sil" Classes="danger" Command="{Binding RemoveCoordinateCommand}" Height="30"/>
                                    </Grid>
                                    <ListBox Height="160" ItemsSource="{Binding Coordinates}" SelectedItem="{Binding SelectedCoordinate}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayText}" FontFamily="Consolas" Foreground="Cyan"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- SEKME 3: MAKRO & PROFİL & KONTROL -->
                        <TabItem Header="Makro &amp; Profil">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="8" Margin="0,5,0,0">
                                    <!-- Profil İşlemleri -->
                                    <TextBlock Text="Profil Yönetimi" Classes="header"/>
                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="5">
                                        <Button Content="Profili Kaydet" Classes="primary" Click="OnSaveProfileClick" Height="30"/>
                                        <Button Grid.Column="1" Content="Profil Yükle" Classes="primary" Click="OnLoadProfileClick" Height="30"/>
                                    </Grid>

                                    <!-- Başlat / Durdur Butonları (Makro Bölümünün İçinde) -->
                                    <TextBlock Text="Otomasyon Kontrolü" Classes="header" Margin="0,5,0,0"/>
                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="5">
                                        <Button Grid.Column="0" Content="Başlat" Classes="success" Command="{Binding StartCommand}" IsEnabled="{Binding !IsRunning}" Height="32"/>
                                        <Button Grid.Column="1" Content="Durdur" Classes="danger" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" Height="32"/>
                                    </Grid>

                                    <!-- Geri Sayım Kutusu -->
                                    <Border BorderBrush="#444444" BorderThickness="1" CornerRadius="4" Padding="8" Background="#1f1f1f">
                                        <StackPanel Spacing="3">
                                            <CheckBox Content="Geri sayım sonunda makro dursun" IsChecked="{Binding EnableCountdown}" Foreground="White" FontSize="11"/>
                                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                                <TextBlock Text="Süre:" VerticalAlignment="Center" Foreground="White" FontSize="11"/>
                                                <TextBox Text="{Binding CdHours}" Width="35" Height="26" HorizontalContentAlignment="Center" IsEnabled="{Binding CanEditCountdown}"/>
                                                <TextBlock Text=":" VerticalAlignment="Center" Foreground="White"/>
                                                <TextBox Text="{Binding CdMinutes}" Width="35" Height="26" HorizontalContentAlignment="Center" IsEnabled="{Binding CanEditCountdown}"/>
                                                <TextBlock Text=":" VerticalAlignment="Center" Foreground="White"/>
                                                <TextBox Text="{Binding CdSeconds}" Width="35" Height="26" HorizontalContentAlignment="Center" IsEnabled="{Binding CanEditCountdown}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Makro Komut Ekleme ve Listesi -->
                                    <TextBlock Text="Komut Sırası" Classes="header" Margin="0,5,0,0"/>
                                    <Grid ColumnDefinitions="50, *" RowDefinitions="Auto, Auto" Margin="0,0,0,3">
                                        <TextBlock Text="Tip:" VerticalAlignment="Center" Foreground="White"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding CmdTypes}" SelectedItem="{Binding CmdType}" Height="28"/>

                                        <TextBlock Grid.Row="1" Text="Değer:" VerticalAlignment="Center" Foreground="White"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CmdValue}" Height="28"/>
                                    </Grid>
                                    <Button Content="Komutu Sıraya Ekle" Classes="primary" Command="{Binding AddCommandCommand}" Height="30"/>

                                    <ListBox Height="110" ItemsSource="{Binding Commands}" SelectedItem="{Binding SelectedCommand}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Description}" FontFamily="Consolas" Foreground="#ffcc00"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="5">
                                        <Button Content="▲ Yukarı" Classes="neutral" Command="{Binding MoveCommandUpCommand}" Height="28"/>
                                        <Button Grid.Column="1" Content="▼ Aşağı" Classes="neutral" Command="{Binding MoveCommandDownCommand}" Height="28"/>
                                    </Grid>
                                    <Button Content="Seçili Komutu Sil" Classes="danger" Command="{Binding RemoveCommandCommand}" Height="28"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                    </TabControl>

                </Grid>
            </Border>
        </StackPanel>

        <!-- 3. Koordinat Seçim Modu Aktifken Görünecek Uyarı Bandı -->
        <Border Background="#CCFF3300" IsVisible="{Binding IsPickingCoordinate}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,15,0,0" Padding="15,8" CornerRadius="6" ZIndex="999">
            <TextBlock Text="🎯 Lütfen ekranda hedef noktaya sol tıklayın..." Foreground="White" FontWeight="Bold" FontSize="14"/>
        </Border>
    </Grid>
</Window>