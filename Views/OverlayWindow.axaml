<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WaydroidController.ViewModels"
        xmlns:m="using:WaydroidController.Models"
        xmlns:v="using:WaydroidController.Views"
        x:Class="WaydroidController.Views.OverlayWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Waydroid Controller"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        Topmost="True"
        WindowState="Maximized">

    <Grid>
        <!-- 0. Düzenleme Modu Aktifken Arka Planı Hafif Karartan Perde -->
        <Border Background="#44000000" IsVisible="{Binding IsPanelOpen}" IsHitTestVisible="False"/>

        <!-- 1. Ekran Üzerindeki Tap Tuşları (Canvas & Sürüklenebilir) -->
        <ItemsControl ItemsSource="{Binding KeyBindings}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas Background="Transparent"
                            PointerPressed="OnCanvasPointerPressed"
                            PointerMoved="OnCanvasPointerMoved"
                            PointerReleased="OnCanvasPointerReleased"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.Styles>
                <Style Selector="ContentPresenter" x:DataType="m:KeyBinding">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                </Style>
            </ItemsControl.Styles>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="42" Height="42" CornerRadius="21"
                            BorderThickness="1.5"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Classes.pressed="{Binding IsPressed}"
                            PointerPressed="OnKeyBadgePointerPressed"
                            PointerMoved="OnKeyBadgePointerMoved"
                            PointerReleased="OnKeyBadgePointerReleased"
                            Tag="{Binding}">
                        <Border.Styles>
                            <Style Selector="Border">
                                <Setter Property="Background" Value="#AA1E1E1E"/>
                                <Setter Property="BorderBrush" Value="#00FFCC"/>
                            </Style>
                            <Style Selector="Border.pressed">
                                <Setter Property="Background" Value="#B300FF66"/>
                                <Setter Property="BorderBrush" Value="#FFFFFF"/>
                            </Style>
                        </Border.Styles>

                        <TextBlock Text="{Binding KeyName}" Foreground="#FFFFFF"
                                   FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 2. Ekran Üzerindeki Çember Joystick Grupları (Canvas & Tek Parça Sürüklenebilir) -->
        <ItemsControl ItemsSource="{Binding JoystickGroups}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas Background="Transparent"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.Styles>
                <Style Selector="ContentPresenter" x:DataType="m:JoystickGroup">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                </Style>
            </ItemsControl.Styles>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Width="140" Height="140"
                          Margin="-70,-70,0,0"
                          Background="Transparent"
                          PointerPressed="OnJoystickPointerPressed"
                          PointerMoved="OnJoystickPointerMoved"
                          PointerReleased="OnJoystickPointerReleased"
                          Tag="{Binding}">

                        <!-- Dış Çember -->
                        <Ellipse Width="140" Height="140"
                                 Stroke="#00FFCC" StrokeThickness="2" Fill="#221E1E1E"/>

                        <!-- Üst Tuş (Up) -->
                        <Border Width="36" Height="36" CornerRadius="18" Background="#AA1E1E1E" BorderBrush="#00FFCC" BorderThickness="1.5"
                                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">
                            <TextBlock Text="{Binding UpKey}" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Sol Tuş (Left) -->
                        <Border Width="36" Height="36" CornerRadius="18" Background="#AA1E1E1E" BorderBrush="#00FFCC" BorderThickness="1.5"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="{Binding LeftKey}" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Sağ Tuş (Right) -->
                        <Border Width="36" Height="36" CornerRadius="18" Background="#AA1E1E1E" BorderBrush="#00FFCC" BorderThickness="1.5"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="{Binding RightKey}" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Alt Tuş (Down) -->
                        <Border Width="36" Height="36" CornerRadius="18" Background="#AA1E1E1E" BorderBrush="#00FFCC" BorderThickness="1.5"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
                            <TextBlock Text="{Binding DownKey}" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 3. MuMu Tarzı Sağ Tık Açılır Menüsü (TranslateTransform ile Piksel Hassasiyetinde Konumlandırma) -->
        <Border IsVisible="{Binding IsContextMenuOpen}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Width="160" Background="#DD242424" BorderBrush="#444" BorderThickness="1" CornerRadius="6" Padding="6"
                ZIndex="1000">
            <Border.RenderTransform>
                <TranslateTransform X="{Binding ContextMenuX}" Y="{Binding ContextMenuY}"/>
            </Border.RenderTransform>
            <StackPanel Spacing="4">
                <TextBlock Text="Tuş Ekle" Foreground="#888" FontSize="11" FontWeight="Bold" Margin="4,2"/>
                <Button Content="➕ Tap (Dokunma) Ekle" Classes="primary" HorizontalAlignment="Stretch" Command="{Binding AddTapFromContextMenuCommand}"/>
                <Button Content="🎮 Joystick (WASD) Ekle" Classes="neutral" HorizontalAlignment="Stretch" Command="{Binding AddJoystickFromContextMenuCommand}"/>
            </StackPanel>
        </Border>

        <!-- 4. MuMu Tarzı Sağ Kenara Sabitlenmiş Dikey Araç Çubuğu (Sidebar) -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Background="#DD1E1E1E" BorderBrush="#333333" BorderThickness="1,0,0,0"
                Padding="6,15,6,10" Width="52">
            <StackPanel Spacing="15" HorizontalAlignment="Center">

                <!-- Tuş Atama / Düzenleme Modu Butonu (F12 Kısayolu) -->
                <Button Content="⌨" ToolTip.Tip="Tuş Atama Modunu Aç/Kapat (F12)"
                        Classes="primary" Width="38" Height="38" FontSize="16"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding TogglePanelCommand}"/>

                <Separator Background="#444" Height="1" Margin="2,0"/>

                <!-- Koordinat Seçim Aracı -->
                <Button Content="🎯" ToolTip.Tip="Koordinat Seç"
                        Classes="neutral" Width="38" Height="38" FontSize="14"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding StartPickingCoordinateCommand}"/>

                <!-- Ayarlar -->
                <Button Content="⚙" ToolTip.Tip="Ayarlar"
                        Classes="neutral" Width="38" Height="38" FontSize="14"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

            </StackPanel>
        </Border>

        <!-- 5. Bilgi Bandı (Sadece Düzenleme Modu Aktifken) -->
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Spacing="5" Margin="0,15,0,0" ZIndex="999">
            <Border Background="#CC0066FF" IsVisible="{Binding IsPanelOpen}" Padding="15,6" CornerRadius="6">
                <TextBlock Text="💡 Düzenleme Modu Açık (F12): Sağ tıklayarak menü açabilir, tuşları veya joystick'i sürükleyebilirsiniz." Foreground="White" FontWeight="SemiBold" FontSize="12"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>