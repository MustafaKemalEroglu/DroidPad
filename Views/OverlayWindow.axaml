<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DroidPad.ViewModels"
        xmlns:m="using:DroidPad.Models"
        x:Class="DroidPad.Views.OverlayWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="DroidPad"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Topmost="True"
        WindowState="Maximized">

    <Grid x:Name="Root" Background="Transparent">

        <!-- 0. Oyun yüzeyi: dokunmayı Android'e iletir -->
        <Border x:Name="Surface" Background="Transparent"/>

        <!-- 1. Düzenleme modu karartması -->
        <Border Background="#55000000" IsVisible="{Binding State.IsEditMode}" IsHitTestVisible="False"/>

        <!-- 2. Tuş eşlemeleri (cihaz koordinat uzayında çizilir, Viewbox ekrana ölçekler) -->
        <Viewbox x:Name="ItemsLayer" Stretch="Fill"
                 IsVisible="{Binding State.ItemsVisible}"
                 IsHitTestVisible="{Binding State.IsEditMode}"
                 Opacity="{Binding EffectiveOpacity}">
            <Grid Width="{Binding DeviceWidth}" Height="{Binding DeviceHeight}">

                <ItemsControl ItemsSource="{Binding JoystickGroups}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter" x:DataType="m:JoystickGroup">
                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:JoystickGroup">
                            <Grid Width="{Binding Diameter}" Height="{Binding Diameter}" Background="Transparent">
                                <Ellipse Classes="ring" Classes.selected="{Binding IsSelected}"
                                         StrokeThickness="3" Fill="#331B1E24"/>
                                <Border Classes="dirkey" Classes.pressed="{Binding IsUpPressed}" Width="40" Height="40" CornerRadius="20"
                                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding UpLabel}" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Classes="dirkey" Classes.pressed="{Binding IsDownPressed}" Width="40" Height="40" CornerRadius="20"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding DownLabel}" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Classes="dirkey" Classes.pressed="{Binding IsLeftPressed}" Width="40" Height="40" CornerRadius="20"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding LeftLabel}" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Classes="dirkey" Classes.pressed="{Binding IsRightPressed}" Width="40" Height="40" CornerRadius="20"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding RightLabel}" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Ellipse Width="26" Height="26" Fill="#CC5EEAD4" IsHitTestVisible="False">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="{Binding ThumbDx}" Y="{Binding ThumbDy}"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding KeyBindings}" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:KeyBinding">
                            <Canvas IsVisible="{Binding IsSwipe}">
                                <Line StartPoint="{Binding StartPoint}" EndPoint="{Binding EndPoint}"
                                      Stroke="#5EEAD4" StrokeThickness="3" StrokeDashArray="6,4"/>
                                <Ellipse Canvas.Left="{Binding EndLeft}" Canvas.Top="{Binding EndTop}"
                                         Width="16" Height="16" Fill="#CC5EEAD4"/>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding KeyBindings}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter" x:DataType="m:KeyBinding">
                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:KeyBinding">
                            <Border Classes="key" Classes.pressed="{Binding IsPressed}" Classes.selected="{Binding IsSelected}"
                                    Width="46" Height="46" CornerRadius="23">
                                <Grid IsHitTestVisible="False">
                                    <TextBlock Text="{Binding KeyLabel}" Foreground="White" FontSize="16" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Badge}" Foreground="#FFD34D" FontSize="9" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Viewbox>

        <!-- 3. Üst durum rozetleri -->
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Spacing="6" Margin="0,14,0,0" IsHitTestVisible="False">
            <Border Background="#E62F6FED" IsVisible="{Binding State.IsEditMode}" Padding="14,7" CornerRadius="8">
                <TextBlock Foreground="White" FontWeight="SemiBold" FontSize="12"
                           Text="Tuş Eşleme  ·  Sağ tık: menü  ·  Sürükle: taşı  ·  Del: sil  ·  F12: kapat"/>
            </Border>
            <Border Background="#E6D98E04" IsVisible="{Binding State.IsPickingEnd}" Padding="14,7" CornerRadius="8">
                <TextBlock Foreground="Black" FontWeight="Bold" FontSize="13" Text="➜ Kaydırmanın bitiş noktasına tıklayın  (Esc: iptal)"/>
            </Border>
            <Border Background="#E6D98E04" IsVisible="{Binding State.IsWaitingForKey}" Padding="14,7" CornerRadius="8">
                <TextBlock Foreground="Black" FontWeight="Bold" FontSize="13" Text="{Binding State.RebindHint}"/>
            </Border>
            <Border Background="#E6D98E04" IsVisible="{Binding State.IsPicking}" Padding="14,7" CornerRadius="8">
                <TextBlock Foreground="Black" FontWeight="Bold" FontSize="13" Text="🎯 Koordinat için ekranda bir noktaya tıklayın  (Esc: iptal)"/>
            </Border>
            <Border Background="#E6D64550" IsVisible="{Binding State.IsRecording}" Padding="14,7" CornerRadius="8">
                <TextBlock Foreground="White" FontWeight="Bold" FontSize="13" Text="⏺ Makro kaydediliyor — ekranda tıklayın / kaydırın"/>
            </Border>
            <Border Background="#E61F9D5B" IsVisible="{Binding State.IsRunning}" Padding="14,7" CornerRadius="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Foreground="White" FontWeight="Bold" FontSize="13" Text="▶ Makro çalışıyor  (F9: durdur)"/>
                    <TextBlock Foreground="White" FontWeight="Bold" FontSize="13" Text="{Binding RemainingText}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 4. Sağ tık menüsü (tuş eşleme modunun tek kontrol yüzeyi) -->
        <Border x:Name="ContextMenuBorder" IsVisible="{Binding State.IsContextMenuOpen}" ZIndex="1000"
                HorizontalAlignment="Left" VerticalAlignment="Top" Width="230"
                Background="#F01B1E24" BorderBrush="#343944" BorderThickness="1" CornerRadius="8" Padding="6">
            <Border.RenderTransform>
                <TranslateTransform X="{Binding State.ContextMenuX}" Y="{Binding State.ContextMenuY}"/>
            </Border.RenderTransform>
            <ScrollViewer MaxHeight="680"><StackPanel Spacing="4" Margin="0,0,6,0">
                <StackPanel Spacing="4" IsVisible="{Binding HasSelection}">
                    <TextBlock Classes="section" Text="SEÇİLİ ÖĞE"/>
                    <StackPanel Spacing="4" IsVisible="{Binding IsTapSelected}">
                        <Button Classes="primary" Content="{Binding SelectedTap.KeyLabel, StringFormat='Tuş: {0}  —  değiştir'}"
                                Command="{Binding BeginRebindCommand}" CommandParameter="key"/>
                        <UniformGrid Columns="3">
                            <Button Margin="2" Content="Tap" ToolTip.Tip="Basınca tek dokunuş" Command="{Binding SetKindCommand}" CommandParameter="tap"/>
                            <Button Margin="2" Content="Turbo" ToolTip.Tip="Basılı tutunca hızlı tekrar" Command="{Binding SetKindCommand}" CommandParameter="turbo"/>
                            <Button Margin="2" Content="Kaydır" ToolTip.Tip="Basınca kaydırma" Command="{Binding SetKindCommand}" CommandParameter="swipe"/>
                        </UniformGrid>
                        <UniformGrid Columns="2" IsVisible="{Binding SelectedTap.IsTurbo}">
                            <Button Margin="2" Content="Daha hızlı" Command="{Binding AdjustTurboCommand}" CommandParameter="-20"/>
                            <Button Margin="2" Content="Daha yavaş" Command="{Binding AdjustTurboCommand}" CommandParameter="20"/>
                        </UniformGrid>
                        <Button IsVisible="{Binding SelectedTap.IsSwipe}" Content="➜  Bitiş noktasını seç" Command="{Binding BeginEndPickCommand}"/>
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding IsJoystickSelected}">
                        <UniformGrid Columns="4">
                            <Button Margin="2" Content="{Binding SelectedJoystick.UpLabel, StringFormat='↑ {0}'}" Command="{Binding BeginRebindCommand}" CommandParameter="up"/>
                            <Button Margin="2" Content="{Binding SelectedJoystick.LeftLabel, StringFormat='← {0}'}" Command="{Binding BeginRebindCommand}" CommandParameter="left"/>
                            <Button Margin="2" Content="{Binding SelectedJoystick.DownLabel, StringFormat='↓ {0}'}" Command="{Binding BeginRebindCommand}" CommandParameter="down"/>
                            <Button Margin="2" Content="{Binding SelectedJoystick.RightLabel, StringFormat='→ {0}'}" Command="{Binding BeginRebindCommand}" CommandParameter="right"/>
                        </UniformGrid>
                        <UniformGrid Columns="2">
                            <Button Margin="2" Content="Yarıçap −" Command="{Binding ResizeJoystickCommand}" CommandParameter="-10"/>
                            <Button Margin="2" Content="Yarıçap +" Command="{Binding ResizeJoystickCommand}" CommandParameter="10"/>
                        </UniformGrid>
                    </StackPanel>
                    <Button Classes="danger" Content="🗑  Sil" Command="{Binding DeleteSelectedCommand}"/>
                </StackPanel>

                <TextBlock Classes="section" Text="BURAYA EKLE"/>
                <Button Classes="tool" Content="⊙  Tuş (Tap)" Command="{Binding AddFromContextMenuCommand}" CommandParameter="tap"/>
                <Button Classes="tool" Content="✥  Joystick (WASD)" Command="{Binding AddFromContextMenuCommand}" CommandParameter="wasd"/>
                <Button Classes="tool" Content="✥  Joystick (Oklar)" Command="{Binding AddFromContextMenuCommand}" CommandParameter="arrows"/>
                <Button Classes="tool" Content="✥  Joystick (Numpad)" Command="{Binding AddFromContextMenuCommand}" CommandParameter="numpad"/>

                <TextBlock Classes="section" Text="PROFİL"/>
                <TextBlock Classes="hint" Text="{Binding ActiveProfileName, StringFormat='Aktif: {0}'}"/>
                <Button Content="Bu uygulama için kaydet" Command="{Binding SaveForCurrentAppCommand}"/>
                <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfileName}" HorizontalAlignment="Stretch"/>
                <UniformGrid Columns="2">
                    <Button Margin="2" Content="Yükle" Command="{Binding LoadSelectedProfileCommand}"/>
                    <Button Margin="2" Classes="danger" Content="Sil" Command="{Binding DeleteSelectedProfileCommand}"/>
                    <Button Margin="2" Content="💾 Dışa" Click="OnSaveProfileClick"/>
                    <Button Margin="2" Content="📂 İçe" Click="OnLoadProfileClick"/>
                </UniformGrid>
                <CheckBox Content="Uygulamaya göre otomatik geç" IsChecked="{Binding AutoSwitchProfiles}"/>
                <CheckBox Content="Oyun modunda tuşları göster (F8)" IsChecked="{Binding State.ShowKeys}"/>
                <CheckBox Content="Sağ tık = Geri" IsChecked="{Binding RightClickBack}"/>
                <CheckBox Content="Fare tekerleği = kaydır" IsChecked="{Binding WheelScroll}"/>
                <TextBlock Classes="hint" Text="Oyun modunda tuş saydamlığı"/>
                <Slider Minimum="0.1" Maximum="1" Value="{Binding KeyOpacity}"/>
                <Button Content="Tüm Eşlemeleri Temizle" Command="{Binding ClearMappingsCommand}"/>
                <Button Classes="success" Content="✔  Tuş eşlemeyi kapat (F12)" Command="{Binding ShowPanelCommand}" CommandParameter="{x:Static vm:PanelKind.Keys}"/>
            </StackPanel></ScrollViewer>
        </Border>

        <!-- 5. Yan panel -->
        <Border IsVisible="{Binding State.IsSidePanel}" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Width="310" Margin="0,10,60,10" Background="#F2181A1F" BorderBrush="#2A2E37" BorderThickness="1" CornerRadius="12">
            <Grid>
                <!-- MAKRO -->
                <ScrollViewer IsVisible="{Binding State.IsMacroPanel}" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="title" Text="▶  Makro"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Button Classes="success" Content="▶  Başlat  (F9)" Command="{Binding StartCommand}" IsVisible="{Binding !IsRunning}"/>
                            <Button Classes="danger" Content="■  Durdur  (F9)" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}"/>
                            <Button Grid.Column="1" Margin="6,0,0,0" Content="⏺ Kaydet" ToolTip.Tip="Ekrandaki tıklama ve kaydırmaları makroya kaydeder"
                                    Classes.danger="{Binding State.IsRecording}" Command="{Binding ToggleRecordingCommand}"/>
                        </Grid>

                        <CheckBox Content="Süre sınırı (dolunca makro durur)" IsChecked="{Binding EnableCountdown}"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding EnableCountdown}">
                            <NumericUpDown Width="86" Minimum="0" Maximum="99" FormatString="0" ShowButtonSpinner="False" Value="{Binding CdHours}" PlaceholderText="sa"/>
                            <NumericUpDown Width="86" Minimum="0" Maximum="59" FormatString="0" ShowButtonSpinner="False" Value="{Binding CdMinutes}" PlaceholderText="dk"/>
                            <NumericUpDown Width="86" Minimum="0" Maximum="59" FormatString="0" ShowButtonSpinner="False" Value="{Binding CdSeconds}" PlaceholderText="sn"/>
                        </StackPanel>

                        <TextBlock Classes="section" Text="KOMUTLAR"/>
                        <ListBox ItemsSource="{Binding Commands}" SelectedItem="{Binding SelectedCommand}" MinHeight="90" MaxHeight="190">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="m:MacroCommand">
                                    <TextBlock Text="{Binding Description}" FontFamily="monospace" FontSize="12"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <UniformGrid Columns="4">
                            <Button Margin="2" Content="↑" Command="{Binding MoveCommandUpCommand}"/>
                            <Button Margin="2" Content="↓" Command="{Binding MoveCommandDownCommand}"/>
                            <Button Margin="2" Classes="danger" Content="✕" Command="{Binding RemoveCommandCommand}"/>
                            <Button Margin="2" Content="Temizle" Command="{Binding ClearCommandsCommand}"/>
                        </UniformGrid>

                        <Grid ColumnDefinitions="100,*,Auto" ColumnSpacing="4">
                            <ComboBox ItemsSource="{Binding CmdTypes}" SelectedItem="{Binding CmdType}" HorizontalAlignment="Stretch"/>
                            <TextBox Grid.Column="1" Text="{Binding CmdValue}"/>
                            <Button Grid.Column="2" Classes="primary" Content="Ekle" Command="{Binding AddCommandCommand}"/>
                        </Grid>

                        <TextBlock Classes="section" Text="KOORDİNATLAR"/>
                        <ListBox ItemsSource="{Binding Coordinates}" SelectedItem="{Binding SelectedCoordinate}" MinHeight="60" MaxHeight="130">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="m:Coordinate">
                                    <TextBlock Text="{Binding DisplayText}" FontFamily="monospace" FontSize="12"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid ColumnDefinitions="*,56,56" ColumnSpacing="4">
                            <TextBox Text="{Binding CoordName}" PlaceholderText="ad"/>
                            <TextBox Grid.Column="1" Text="{Binding CoordX}" PlaceholderText="x"/>
                            <TextBox Grid.Column="2" Text="{Binding CoordY}" PlaceholderText="y"/>
                        </Grid>
                        <UniformGrid Columns="3">
                            <Button Margin="2" Content="🎯 Seç" Command="{Binding StartPickingCommand}"/>
                            <Button Margin="2" Classes="primary" Content="Ekle" Command="{Binding AddCoordinateCommand}"/>
                            <Button Margin="2" Classes="danger" Content="Sil" Command="{Binding RemoveCoordinateCommand}"/>
                        </UniformGrid>

                        <TextBlock Classes="section" Text="PROFİL"/>
                        <UniformGrid Columns="2">
                            <Button Margin="2" Classes="primary" Content="💾 Dışa aktar" Click="OnSaveProfileClick"/>
                            <Button Margin="2" Content="📂 İçe aktar" Click="OnLoadProfileClick"/>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- GÜNLÜK -->
                <Grid IsVisible="{Binding State.IsLogPanel}" Margin="14" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                    <TextBlock Classes="title" Text="☰  Günlük &amp; Bağlantı"/>
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Ellipse Classes="conn" Width="10" Height="10" VerticalAlignment="Center" Classes.on="{Binding IsAdbConnected}"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="#E8EAF0" Text="{Binding ConnectionText}"/>
                        <Button Grid.Column="2" Content="Yeniden bağlan" Command="{Binding ConnectCommand}"/>
                    </Grid>
                    <ListBox x:Name="LogList" Grid.Row="2" ItemsSource="{Binding Log}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="m:LogEntry">
                                <TextBlock Text="{Binding Text}" Foreground="{Binding ColorHex}" FontFamily="monospace" FontSize="11" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="3" Content="Günlüğü Temizle" Click="OnClearLogClick"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 6. Kenar çubuğu -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                Background="#F2181A1F" BorderBrush="#2A2E37" BorderThickness="1" CornerRadius="14" Padding="6">
            <StackPanel Spacing="6">
                <Button x:Name="KeysButton" Classes="side" Content="⌨" ToolTip.Tip="Tuş Eşleme (F12)"
                        Classes.active="{Binding State.IsKeysPanel}"
                        Command="{Binding ShowPanelCommand}" CommandParameter="{x:Static vm:PanelKind.Keys}"/>
                <Button Classes="side" Content="▶" ToolTip.Tip="Makro (F11)"
                        Classes.active="{Binding State.IsMacroPanel}"
                        Command="{Binding ShowPanelCommand}" CommandParameter="{x:Static vm:PanelKind.Macro}"/>
                <Button Classes="side" Content="☰" ToolTip.Tip="Günlük (F10)"
                        Classes.active="{Binding State.IsLogPanel}"
                        Command="{Binding ShowPanelCommand}" CommandParameter="{x:Static vm:PanelKind.Log}"/>
                <Border Height="1" Background="#2A2E37" Margin="4,2"/>
                <Button Classes="side" Content="◀" ToolTip.Tip="Geri" Command="{Binding NavKeyCommand}" CommandParameter="KEYCODE_BACK"/>
                <Button Classes="side" Content="●" ToolTip.Tip="Ana ekran" Command="{Binding NavKeyCommand}" CommandParameter="KEYCODE_HOME"/>
                <Button Classes="side" Content="■" ToolTip.Tip="Son uygulamalar" Command="{Binding NavKeyCommand}" CommandParameter="KEYCODE_APP_SWITCH"/>
                <Button Classes="side" Content="🔊" ToolTip.Tip="Sesi artır" Command="{Binding NavKeyCommand}" CommandParameter="KEYCODE_VOLUME_UP"/>
                <Button Classes="side" Content="🔉" ToolTip.Tip="Sesi azalt" Command="{Binding NavKeyCommand}" CommandParameter="KEYCODE_VOLUME_DOWN"/>
                <Button Classes="side" Content="📷" ToolTip.Tip="Ekran görüntüsü (~/Pictures/DroidPad)" Command="{Binding ScreenshotCommand}"/>
                <Button Classes="side" Content="📦" ToolTip.Tip="APK kur" Click="OnInstallApkClick"/>
                <Border Height="1" Background="#2A2E37" Margin="4,2"/>
                <Ellipse Classes="conn" Width="9" Height="9" HorizontalAlignment="Center" Classes.on="{Binding IsAdbConnected}"
                         ToolTip.Tip="{Binding ConnectionText}"/>
                <Button Classes="side" Content="✕" ToolTip.Tip="Çıkış" Click="OnExitClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
